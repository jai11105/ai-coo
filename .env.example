# AI COO env template — no real credentials. Copy to .env.local for local/prod.
# Real keys are NEVER committed. See PROVIDER_CONFIG.md for owners of each value.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder

# Server-only. Do not prefix with NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
META_API_KEY=your-meta-api-key-placeholder
META_BASE_URL=https://api.meta.ai/v1
# Primary COO reasoning model (Muse Spark Standard). Do not change for extraction.
META_MODEL_ID=muse-spark-1.3
# Log Entry voice transcription (Meta Muse Voice Transcribe 1.0 file endpoint).
META_ASR_TRANSCRIBE_URL=https://api.meta.ai/v1/asr/transcribe
# Log Entry transcript-to-JSON extraction ONLY (Muse Spark Contributor via Meta API).
META_EXTRACTION_MODEL_ID=muse-spark-1.3-contributor
# Copilot creative image generation ONLY (Muse Image via Meta API).
# Verified contract: POST {META_BASE_URL}/images/generations with { model, prompt, size }.
# Uses the same META_API_KEY Bearer credential as chat — no separate image key.
META_IMAGE_MODEL=muse-image-1.0
# Baseten specialist (Muse Spark Open 1026). Deployment base URL is required —
# obtain the exact invoke URL + model/deployment ID from the Baseten dashboard.
# Never invent a deployment URL; leave BASETEN_BASE_URL empty until provisioned.
BASETEN_API_KEY=your-baseten-api-key-placeholder
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MUSE_SPARK_MODEL_ID=your-baseten-model-id-placeholder
# Fireworks secondary reasoning fallback (Meta Muse serverless model).
# Default resolved live via GET {FIREWORKS_BASE_URL}/models:
# muse-spark-open = HTTP 200 verified; muse-glimmer-30b = HTTP 404 not deployed.
FIREWORKS_API_KEY=your-fireworks-api-key-placeholder
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL_ID=accounts/fireworks/models/muse-spark-open
# Meta MMS TTS (facebook/mms-tts-eng) — CC-BY-NC 4.0, see README attribution.
MMS_TTS_ENDPOINT_URL=https://your-tts-endpoint.example.com/synthesize
MMS_TTS_MODEL_ID=facebook/mms-tts-eng
# Demo flag: show model attribution under assistant answers in Copilot chat (set to false to hide AI labels).
NEXT_PUBLIC_SHOW_MODEL_ATTRIBUTION=true
